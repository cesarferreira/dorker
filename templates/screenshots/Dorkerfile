# Installs one app and opens it when an instance is ready.
FROM android:35

MEMORY 2GB
CPUS 2
DISK 4GB

DEVICE pixel_7
RESOLUTION 1080x2400
HEADLESS true

# Put your APK here and set its package name below.
INSTALL ./app.apk
CMD launch com.example.app

# Animations off, so a screenshot is never taken mid-transition.
SETTING window_animation_scale 0
SETTING transition_animation_scale 0
SETTING animator_duration_scale 0

SNAPSHOT ready
