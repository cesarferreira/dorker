# Installs the debug app and its instrumentation tests from a standard Gradle layout.
# Change the paths if your module is not called `app`. Both files must exist when you
# build, so run `./gradlew assembleDebug assembleDebugAndroidTest` first (run-tests.sh does).
FROM android:35

MEMORY 2GB
CPUS 2
DISK 4GB

DEVICE pixel_7
HEADLESS true

INSTALL ./app/build/outputs/apk/debug/app-debug.apk
INSTALL ./app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk

# Animations make UI tests slow and flaky.
SETTING window_animation_scale 0
SETTING transition_animation_scale 0
SETTING animator_duration_scale 0

SNAPSHOT ready
